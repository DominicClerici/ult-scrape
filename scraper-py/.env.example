UG_EMAIL=
UG_PASSWORD=
# Leave UG_PROXY blank to make bare requests with no proxy. To route through
# Decodo, use a sticky-session endpoint so the exit IP stays stable across the
# login + scrape lifecycle (e.g. a sticky port, or a -session-<id> username).
UG_PROXY=
UG_PROXY_USERNAME=
UG_PROXY_PASSWORD=
# Shared with the decoder. Relative paths resolve from scraper-py/ (the service's
# working dir), so ../output points at the repo-root output/ directory.
OUTPUT_DIR=../output
DB_PATH=./scraper.db
PROFILE_DIR=./camoufox-profile
FINGERPRINT_PATH=./camoufox-fingerprint.json
HEADLESS=false
MAX_ATTEMPTS=3
BACKOFF_BASE_SECONDS=30
INTER_JOB_DELAY_MIN=5
INTER_JOB_DELAY_MAX=20
CLOUDFLARE_TIMEOUT_MS=120000
CAPTURE_WINDOW_MS=30000
# Auto-pause the worker after this many consecutive non-successful jobs (safety
# circuit breaker). Persisted pause survives restart; resume via POST /resume.
CIRCUIT_BREAKER_THRESHOLD=5
# Cool-off (seconds) after a 403/429 rate-limit before the next job.
RATE_LIMIT_DELAY_SECONDS=300
# Delay (seconds) before re-attempting a job whose session expired (no retry consumed).
SESSION_EXPIRY_BACKOFF_SECONDS=60
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=
POLL_INTERVAL_SECONDS=5
# --- Discovery (Pro tab enumeration) ---
DISCOVERY_SORT_ORDERS=date_desc,artistname_asc,artistname_desc,songname_asc
DISCOVERY_FACET_LADDER=genres,decade,tonality
DISCOVERY_PAGE_DELAY_MIN=2.0
DISCOVERY_PAGE_DELAY_MAX=6.0
DISCOVERY_MAX_SLICES=0
DISCOVERY_TARGET_CAP=0
DISCOVERY_REQUEST_TIMEOUT_MS=30000
DISCOVERY_UNTAGGED_SWEEP=true
